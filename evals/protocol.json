{
  "schema_version": 1,
  "name": "GraphOS bounded static-web evaluation protocol",
  "integration": {
    "purpose": "Check composed HTTP, PostgreSQL, worker, artifact and browser-verifier behavior",
    "mode": "integration-fixture",
    "fixture_results_count_as_model_success": false,
    "cases": [
      "happy_fixture_release",
      "duplicate_admission_and_submission",
      "registered_profile_boundary",
      "roles_and_cancellation",
      "evidence_revision_and_artifact_binding",
