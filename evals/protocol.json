    "split_unit": "project or repository",
    "splits": ["development", "validation", "untouched release"],
    "configurations": ["single capable agent", "single builder plus verifier", "fixed graph", "adaptive graph"],
    "controls": ["task specification", "aggregate model and tool cost ceiling", "elapsed-time ceiling", "CPU and RAM limits", "network policy", "tool and model versions"],
    "metrics": ["verified completion", "cost per verified completion including failures", "time to verified completion", "pass^k by task", "escaped defects", "human intervention", "recovery outcomes"],
    "uncertainty": "Paired, project-clustered intervals; no accuracy estimates from fixture runs",
    "promotion": "Predeclare superiority or noninferiority criteria before the held-out run"
  }
