# Copy to an uncommitted private environment file; scripts/setup.py generates
# local credentials automatically. Never commit a real key or token.
GRAPHOS_DATABASE_URL=
GRAPHOS_ARTIFACT_ROOT=.state/artifacts
GRAPHOS_OPERATOR_TOKEN=
GRAPHOS_BUILDER_TOKEN=
GRAPHOS_VERIFIER_TOKEN=
GRAPHOS_VERIFIER_IMAGE=graphos-verifier:local
GRAPHOS_VERIFIER_IMAGE_DIGEST=
GRAPHOS_API_URL=http://127.0.0.1:8030
GRAPHOS_ALLOW_FIXTURE=0
# Gateway secrets belong only to the eve server, never the builder/verifier.
AI_GATEWAY_API_KEY=
GRAPHOS_EVE_TOKEN=
EVE_SERVER_URL=http://127.0.0.1:3001
GRAPHOS_LIVE_ENABLED=0
GRAPHOS_SESSION_BUDGET_MICRODOLLARS=5000000
